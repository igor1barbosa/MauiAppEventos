<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.ResumoEvento"
             Title="Resumo do Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="{Binding Nome}" FontSize="24" FontAttributes="Bold" />

            <Label Text="{Binding Local, StringFormat='Local: {0}'}" />
            <Label Text="{Binding DataInicio, StringFormat='Início: {0:dd/MM/yyyy}'}" />
            <Label Text="{Binding DataFim, StringFormat='Término: {0:dd/MM/yyyy}'}" />
            <Label Text="{Binding Duracao, StringFormat='Duração: {0:%d} dia(s)'}" />
            <Label Text="{Binding Duracao, StringFormat='Intervalo (TimeSpan): {0:c}'}" />

            <Label Text="{Binding NumParticipantes, StringFormat='Participantes: {0}'}" />
            <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por participante: {0:C}'}" />

            <Label Text="{Binding CustoTotal, StringFormat='Custo total: {0:C}'}"
                   FontSize="20" FontAttributes="Bold" TextColor="#512BD4" Margin="0,10,0,0" />

            <Button Text="Novo cadastro" Margin="0,15,0,0" Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
