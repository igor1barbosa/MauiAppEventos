<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.CadastroEvento"
             Title="Cadastro de Eventos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Nome do evento" />
            <Entry x:Name="txt_nome" Placeholder="Ex.: Semana de Tecnologia" />

            <Label Text="Data de início" />
            <DatePicker x:Name="dtpck_inicio" Format="dd/MM/yyyy" />

            <Label Text="Data de término" />
            <DatePicker x:Name="dtpck_fim" Format="dd/MM/yyyy" />

            <Label Text="Número de participantes" />
            <Entry x:Name="txt_participantes" Placeholder="Ex.: 20" Keyboard="Numeric" />

            <Label Text="Local do evento" />
            <Entry x:Name="txt_local" Placeholder="Ex.: Auditório da ETEC" />

            <Label Text="Custo por participante (R$)" />
            <Entry x:Name="txt_custo" Placeholder="Ex.: 50.00" Keyboard="Numeric" />

            <Button Text="Cadastrar" Margin="0,15,0,0" Clicked="Button_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
